{
  "name": "thethechad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm hero:static && next dev --webpack",
    "build": "pnpm hero:static && next build --webpack && node scripts/checkFontFallbacks.mjs",
    "start": "next start",
    "lint": "biome check && node scripts/checkThemeTokens.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/checkCspHash.mjs && node src/components/SkylineHero/buildStaticHero.mjs --check",
    "format": "biome format --write",
    "hero:static": "node src/components/SkylineHero/buildStaticHero.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.x"
  }
}
